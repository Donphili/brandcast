# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://your-domain.com
CRON_SECRET=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

OPAY_ENV=sandbox
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# Naira per 1 USD. Update to the current rate.
NGN_PER_USD=
# kobo (default) or naira. Confirm in the OPay sandbox with a small test order.
OPAY_AMOUNT_UNIT=kobo

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional posting connectors (each is skipped if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
